#--------------------------------------------------------------------
# Example Environment Configuration file - Eleições 2026 (Backend)
# Copie este arquivo para .env e configure as variáveis locais.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/eleicoes2026/backend/public/'
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE — banco `eleicoes` (XAMPP / MySQL)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = eleicoes
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

#--------------------------------------------------------------------
# ELEICOES 2026 — API key para POST /api/coletas (import do scraper)
# Troque para uma chave segura no seu ambiente de produção.
#--------------------------------------------------------------------
ELEICOES_API_KEY = troque-para-sua-chave-secreta-em-producao
